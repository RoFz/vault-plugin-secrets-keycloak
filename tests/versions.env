# Vault & Keycloak image tags exercised by the integration tests.
#
# SINGLE SOURCE OF TRUTH for `make test-integration` / `make test-integration-matrix`
# (local) and the CI integration matrix + release smoke test (which read this
# file). Bump a line here (Renovate or by hand) and both local and CI follow.
#
# Values are exact image tags on Docker Hub (hashicorp/vault) and quay.io
# (keycloak/keycloak). NOTE: image tags are NOT the same as binary release
# versions, verify tags on the registry, not releases.hashicorp.com.

VAULT_MPL=1.14.10      # fixed: last MPL-2.0 line (1.14); not Renovate-managed
VAULT_1X=1.21.4        # Renovate: latest 1.x   (hashicorp/vault, <2.0.0)
VAULT_2X=2.0.2         # Renovate: latest 2.x   (hashicorp/vault, >=2.0.0 <3.0.0)
KEYCLOAK=26.6.3        # Renovate: latest Keycloak (quay.io/keycloak/keycloak)
