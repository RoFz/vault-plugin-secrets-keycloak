# Vault & Keycloak image tags exercised by the integration tests.
#
# SINGLE SOURCE OF TRUTH for `make test-integration` / `make test-integration-matrix`
# (local) and the CI integration matrix + release validation (which read this
# file). Bump a line here (Renovate or by hand) and both local and CI follow.
#
# Values are exact image tags on Docker Hub (hashicorp/vault) and quay.io
# (keycloak/keycloak). NOTE: image tags are NOT the same as binary release
# versions, verify tags on the registry, not releases.hashicorp.com.
#
# The `# renovate:` lines drive automatic updates (see .github/renovate.json5);
# the 1.x vs 2.x version lanes are enforced there via packageRules.

VAULT_MPL=1.14.10      # fixed: last MPL-2.0 line (1.14); intentionally NOT Renovate-managed

# renovate: datasource=docker depName=vault-1x packageName=hashicorp/vault versioning=docker
VAULT_1X=1.21.4        # latest 1.x line (kept <2.0.0)

# renovate: datasource=docker depName=vault-2x packageName=hashicorp/vault versioning=docker
VAULT_2X=2.0.4         # latest 2.x line (kept >=2.0.0 <3.0.0)

# renovate: datasource=docker depName=keycloak packageName=quay.io/keycloak/keycloak versioning=docker
KEYCLOAK=26.6.3        # latest Keycloak
